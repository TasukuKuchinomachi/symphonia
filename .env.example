# SQLite database file
DATABASE_URL="file:./prisma/dev.db"

# Where Project clones / Grain worktrees live
SYMPHONIA_WORKSPACE_DIR="/Users/nomachi/workspace/.symphonia-workspaces"

# Claude CLI binary path (defaults to "claude" on PATH)
CLAUDE_BIN="claude"

# Anthropic API key — read by claude CLI via env when --bare is used
ANTHROPIC_API_KEY=""

# Max concurrent Grain workers per Task
SYMPHONIA_MAX_PARALLEL="3"
